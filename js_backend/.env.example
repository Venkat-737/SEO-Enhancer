# ---- Required for auth (login, signup, protected routes) ----
# Any long random string. Generate e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_KEY=abcd1234

# ---- MongoDB ----
# Local MongoDB (install from https://www.mongodb.com/try/download/community or use Docker)
# Or MongoDB Atlas: https://www.mongodb.com/cloud/atlas → Create cluster → Connect → connection string
DB_URL_LOCAL=mongodb://127.0.0.1:27017/seo
# If you use Atlas, you can set only DB_URL instead and leave DB_URL_LOCAL empty in code, or set both to the same Atlas URI
# DB_URL=

# ---- Server ----
PORT=3000

# ---- Stripe (required for /user/create-payment-intent) ----
# Get keys: https://dashboard.stripe.com/apikeys — use Secret key (sk_test_... for test mode)
STRIPE_SECRET_KEY=

# ---- Optional: email OTP (nodemailer is hardcoded in userRoutes.js; move to env in production) ----
# SMTP_USER=
# SMTP_PASS=
