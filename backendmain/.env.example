# Required for /process_video (transcription + Gemini SEO text).
# Get a key: https://aistudio.google.com/apikey
# Copy this file to .env in this folder and paste your real key. Do not commit .env.
GOOGLE_API_KEY=

# Port for Flask (frontend calls http://localhost:5000)
FLASK_PORT=5000

# Optional — comma-separated Gemini model IDs, tried in order if one returns 404
# (fixes "model not found" when Google renames/retires models)
# GEMINI_MODEL=gemini-2.0-flash

# Optional — only if you use backendmain/temp.py (YouTube experiments), not the main app.py
# YOUTUBE_API_KEY=
# Google Cloud / YouTube Data API: https://console.cloud.google.com/apis/credentials
